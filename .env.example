# ===============================
# Open AI API key and model
# ===============================
OPENAI_API_KEY=
GEN_METADATA_MODEL=gpt-4.1-mini

# ===============================
# Application Settings
# ===============================
APP_NAME=ImageSearchBackend
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# ===============================
# Database (Postgres)
# ===============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=imagedb1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Roastery818

DATABASE_URL=postgresql://postgres:username@host:5432/databasename
# ===============================
# Vector Index
# ===============================
# Choose backend: "faiss" | "qdrant" | "milvus"
CLIP_MODEL=ViT-B/32
VECTOR_BACKEND=faiss
INDEX_BACKEND=faiss
VECTOR_DIM=512
FAISS_INDEX_PATH=/data/faiss.index
DEVICE=cpu

# ===============================
# Storage mode
# ===============================
UPLOAD_MODE=local

# ===============================
# Object Storage (S3/Minio)
# ===============================
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ===============================
# Object Storage (Local)
# ===============================
LOCAL_UPLOAD_DIR=uploads

# ===============================
# Security
# ===============================
JWT_SECRET=change_this_to_a_long_random_string
ALLOWED_ORIGINS=http://localhost:3000,http://yourdomain.com
MAX_UPLOAD_SIZE_MB=10

# ===============================
# Monitoring
# ===============================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ===============================
# Logging
# ===============================
LOG_LEVEL=INFO

# ===============================
# Redis
# ===============================
CELERY_BROKER=redis://redis:6379/0

# ===============================
# Data
# ===============================
REMOTE_FEED_URL=