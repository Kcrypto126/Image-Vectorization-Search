# ===============================
# Open AI API key and model
# ===============================
OPENAI_API_KEY=
GEN_METADATA_MODEL=gpt-4.1-mini

# ===============================
# Application Settings
# ===============================
APP_NAME=ImageSearchBackend
PORT=8000

# ===============================
# Database Settings
# ===============================
POSTGRES_DB=imagedb
POSTGRES_USER=im_user
POSTGRES_PASSWORD=supersecurepassword
DATABASE_URL=postgresql://postgres:username@host:5432/databasename

# ===============================
# Redis / Celery
# ===============================
CELERY_BROKER=redis://localhost:6379/0

# ===============================
# Object Storage (S3/MinIO)
# ===============================
STORAGE_BACKEND=local
S3_BUCKET=images
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# ===============================
# Vector Index
# ===============================
INDEX_BACKEND=faiss
VECTOR_DIM=512
CLIP_MODEL=ViT-B/32
DEVICE=cpu
YOLO_MODEL=yolov8n.pt

# ===============================
# Misc
# ===============================
TMP_DIR=